datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id              String       @id @default(uuid())
  userId          String
  name            String
  description     String?
  defaultLanguage String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions     Submission[]

  @@index([userId])
}

model Submission {
  id        String    @id @default(uuid())
  projectId String
  language  String
  sourceCode String   @db.Text
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis  Analysis?

  @@index([projectId])
}

model Analysis {
  id           String     @id @default(uuid())
  submissionId String     @unique
  status       String     // "bug_found" | "no_bug_found" | "analysis_failed"
  bugs         Json       // Array of bug details [{ line, type, severity, message, explanation }]
  explanation  String     @db.Text
  fixedCode    String?    @db.Text // Nullable: AI might not produce a fix or no fix required
  complexity   Json?      // Nullable: { time?: string, space?: string }
  confidence   Float
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
